{
  "uid": "checkout-slo",
  "title": "Checkout SLO",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (30d SLI)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:checkout_errors:ratio_rate3d"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (3d proxy)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (slo:checkout_errors:ratio_rate3d / 0.005)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Burn rate 1h (x)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:checkout_errors:ratio_rate1h / 0.005"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/checkout\"}[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error ratio by window vs 14.4x/6x thresholds",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:checkout_errors:ratio_rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "slo:checkout_errors:ratio_rate1h",
          "legendFormat": "1h"
        },
        {
          "refId": "C",
          "expr": "slo:checkout_errors:ratio_rate6h",
          "legendFormat": "6h"
        },
        {
          "refId": "D",
          "expr": "vector(0.072)",
          "legendFormat": "14.4x page"
        },
        {
          "refId": "E",
          "expr": "vector(0.03)",
          "legendFormat": "6x page"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Slow-request ratio (>300ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:checkout_slow:ratio_rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "slo:checkout_slow:ratio_rate1h",
          "legendFormat": "1h"
        },
        {
          "refId": "C",
          "expr": "vector(0.144)",
          "legendFormat": "14.4x page"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by code",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(http_requests_total{route=\"/checkout\"}[1m]))",
          "legendFormat": "{{code}}"
        }
      ]
    }
  ]
}